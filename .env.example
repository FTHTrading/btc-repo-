# Environment Configuration Template for All Couch No Cage Protocol Backend
# Copy to .env and populate with your secure API keys

# Server Port
PORT=8098

# NVIDIA NIM / Cloud AI API Keys (Optional - System gracefully falls back to deterministic guidance if omitted)
NVIDIA_API_KEY_NEMOTRON=
NVIDIA_API_KEY_DEEPSEEK=
NVIDIA_API_KEY_LLAMA70B=
NVIDIA_API_KEY_FLUX=
NVIDIA_API_KEY_VIDEO=

# Blockchain RPC (Polygon Amoy / Ethereum Testnet)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
DEPLOYER_PRIVATE_KEY=
